{
  "$defs": {
    "AnalysisGoal": {
      "enum": [
        "LOOKUP",
        "AGGREGATE",
        "TREND",
        "COMPARE",
        "RANK",
        "COMPOSITION",
        "CORRELATION",
        "ANOMALY",
        "CONTRIBUTION",
        "ATTRIBUTION",
        "ROOT_CAUSE",
        "FORECAST",
        "EXPLAIN"
      ],
      "title": "AnalysisGoal",
      "type": "string"
    },
    "BooleanFilterGroup": {
      "additionalProperties": false,
      "properties": {
        "node_type": {
          "const": "BOOLEAN_GROUP",
          "default": "BOOLEAN_GROUP",
          "title": "Node Type",
          "type": "string"
        },
        "operator": {
          "enum": [
            "AND",
            "OR",
            "NOT"
          ],
          "title": "Operator",
          "type": "string"
        },
        "children": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Predicate"
              },
              {
                "$ref": "#/$defs/BooleanFilterGroup"
              }
            ]
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "operator",
        "children"
      ],
      "title": "BooleanFilterGroup",
      "type": "object"
    },
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "BOOLEAN",
          "default": "BOOLEAN",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "BoundSemanticRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding_handle": {
          "type": "string"
        }
      },
      "required": [
        "binding_handle"
      ]
    },
    "Calculation": {
      "enum": [
        "ABS_DIFF",
        "PERCENT_DIFF",
        "GROWTH_RATE",
        "RATIO",
        "INDEX"
      ],
      "title": "Calculation",
      "type": "string"
    },
    "CalendarType": {
      "enum": [
        "NATURAL",
        "FISCAL",
        "ROLLING"
      ],
      "title": "CalendarType",
      "type": "string"
    },
    "CatalogType": {
      "enum": [
        "ENTITY",
        "METRIC",
        "DIMENSION",
        "ATTRIBUTE",
        "ENTITY_VALUE",
        "RELATION",
        "DATASET",
        "REPORT",
        "PHYSICAL_TABLE",
        "PHYSICAL_COLUMN"
      ],
      "title": "CatalogType",
      "type": "string"
    },
    "ChartPreferences": {
      "additionalProperties": false,
      "properties": {
        "chart_type": {
          "default": "AUTO",
          "enum": [
            "LINE",
            "BAR",
            "PIE",
            "SCATTER",
            "AUTO"
          ],
          "title": "Chart Type",
          "type": "string"
        }
      },
      "title": "ChartPreferences",
      "type": "object"
    },
    "ComparisonSpec": {
      "additionalProperties": false,
      "properties": {
        "comparison_type": {
          "$ref": "#/$defs/ComparisonType"
        },
        "baseline": {
          "discriminator": {
            "mapping": {
              "DATASET": "#/$defs/DatasetBaseline",
              "SEMANTIC": "#/$defs/SemanticBaseline",
              "TASK": "#/$defs/TaskBaseline",
              "TIME": "#/$defs/TimeBaseline"
            },
            "propertyName": "baseline_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TimeBaseline"
            },
            {
              "$ref": "#/$defs/TaskBaseline"
            },
            {
              "$ref": "#/$defs/DatasetBaseline"
            },
            {
              "$ref": "#/$defs/SemanticBaseline"
            }
          ],
          "title": "Baseline"
        },
        "current_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "comparison_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "calculation": {
          "$ref": "#/$defs/Calculation"
        },
        "output_metrics": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/BoundSemanticRef"
              },
              {
                "$ref": "#/$defs/ComputedMeasureRef"
              }
            ]
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Output Metrics",
          "type": "array"
        }
      },
      "required": [
        "comparison_type",
        "baseline",
        "calculation",
        "output_metrics"
      ],
      "title": "ComparisonSpec",
      "type": "object"
    },
    "ComparisonType": {
      "enum": [
        "YOY",
        "MOM",
        "PERIOD_OVER_PERIOD",
        "ABSOLUTE_DELTA",
        "PERCENT_CHANGE",
        "RATIO",
        "CUSTOM_PERIOD"
      ],
      "title": "ComparisonType",
      "type": "string"
    },
    "ComputedExpression": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "$ref": "#/$defs/Calculation"
        },
        "baseline": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "DATASET": "#/$defs/DatasetBaseline",
                  "SEMANTIC": "#/$defs/SemanticBaseline",
                  "TASK": "#/$defs/TaskBaseline",
                  "TIME": "#/$defs/TimeBaseline"
                },
                "propertyName": "baseline_type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TimeBaseline"
                },
                {
                  "$ref": "#/$defs/TaskBaseline"
                },
                {
                  "$ref": "#/$defs/DatasetBaseline"
                },
                {
                  "$ref": "#/$defs/SemanticBaseline"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        }
      },
      "required": [
        "calculation"
      ],
      "title": "ComputedExpression",
      "type": "object"
    },
    "ComputedMeasureRef": {
      "additionalProperties": false,
      "properties": {
        "local_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Local Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "computation_type": {
          "enum": [
            "DELTA",
            "GROWTH_RATE",
            "SHARE",
            "CONTRIBUTION",
            "ANOMALY_SCORE",
            "FORECAST",
            "FORECAST_LOWER",
            "FORECAST_UPPER"
          ],
          "title": "Computation Type",
          "type": "string"
        },
        "source_measure_refs": {
          "items": {
            "$ref": "#/$defs/BoundSemanticRef"
          },
          "minItems": 1,
          "title": "Source Measure Refs",
          "type": "array"
        },
        "expression_spec": {
          "$ref": "#/$defs/ComputedExpression"
        },
        "unit": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "format_rule": {
          "enum": [
            "NUMBER",
            "CURRENCY",
            "PERCENT"
          ],
          "title": "Format Rule",
          "type": "string"
        },
        "provenance": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "local_id",
        "display_name",
        "computation_type",
        "source_measure_refs",
        "expression_spec",
        "unit",
        "format_rule",
        "provenance"
      ],
      "title": "ComputedMeasureRef",
      "type": "object"
    },
    "DatasetBaseline": {
      "additionalProperties": false,
      "properties": {
        "baseline_type": {
          "const": "DATASET",
          "default": "DATASET",
          "title": "Baseline Type",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        }
      },
      "required": [
        "dataset_id"
      ],
      "title": "DatasetBaseline",
      "type": "object"
    },
    "DateTimeValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "DATETIME",
          "default": "DATETIME",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "format": "date-time",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "DateTimeValue",
      "type": "object"
    },
    "DateValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "DATE",
          "default": "DATE",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "format": "date",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "DateValue",
      "type": "object"
    },
    "DeliveryMode": {
      "enum": [
        "TEXT",
        "TABLE",
        "CHART",
        "REPORT",
        "EXPORT",
        "DASHBOARD"
      ],
      "title": "DeliveryMode",
      "type": "string"
    },
    "DeliverySpec": {
      "additionalProperties": false,
      "properties": {
        "modes": {
          "items": {
            "$ref": "#/$defs/DeliveryMode"
          },
          "minItems": 1,
          "title": "Modes",
          "type": "array"
        },
        "export_format": {
          "anyOf": [
            {
              "enum": [
                "CSV",
                "XLSX",
                "PDF",
                "DOCX"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Export Format"
        },
        "report_template_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Template Id"
        },
        "chart_preferences": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartPreferences"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DeliverySpec",
      "type": "object"
    },
    "EntityValueRef": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "ENTITY_REF",
          "default": "ENTITY_REF",
          "title": "Value Type",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/BoundSemanticRef"
        }
      },
      "required": [
        "ref"
      ],
      "title": "EntityValueRef",
      "type": "object"
    },
    "EnumValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "ENUM",
          "default": "ENUM",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "enum_code": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Enum Code",
          "type": "string"
        }
      },
      "required": [
        "value",
        "enum_code"
      ],
      "title": "EnumValue",
      "type": "object"
    },
    "FilterOperator": {
      "enum": [
        "AND",
        "OR",
        "NOT",
        "EQ",
        "NE",
        "IN",
        "NOT_IN",
        "GT",
        "GTE",
        "LT",
        "LTE",
        "LIKE",
        "NOT_LIKE",
        "BETWEEN",
        "IS_NULL",
        "IS_NOT_NULL"
      ],
      "title": "FilterOperator",
      "type": "string"
    },
    "ListValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "LIST",
          "default": "LIST",
          "title": "Value Type",
          "type": "string"
        },
        "values": {
          "items": {
            "discriminator": {
              "mapping": {
                "BOOLEAN": "#/$defs/BooleanValue",
                "DATE": "#/$defs/DateValue",
                "DATETIME": "#/$defs/DateTimeValue",
                "ENTITY_REF": "#/$defs/EntityValueRef",
                "ENUM": "#/$defs/EnumValue",
                "NULL": "#/$defs/NullValue",
                "NUMBER": "#/$defs/NumberValue",
                "STRING": "#/$defs/StringValue"
              },
              "propertyName": "value_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StringValue"
              },
              {
                "$ref": "#/$defs/NumberValue"
              },
              {
                "$ref": "#/$defs/BooleanValue"
              },
              {
                "$ref": "#/$defs/DateValue"
              },
              {
                "$ref": "#/$defs/DateTimeValue"
              },
              {
                "$ref": "#/$defs/EnumValue"
              },
              {
                "$ref": "#/$defs/EntityValueRef"
              },
              {
                "$ref": "#/$defs/NullValue"
              }
            ]
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "title": "ListValue",
      "type": "object"
    },
    "MissingPeriodPolicy": {
      "enum": [
        "LEAVE_MISSING",
        "ZERO_FILL",
        "NULL_FILL"
      ],
      "title": "MissingPeriodPolicy",
      "type": "string"
    },
    "NullValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "NULL",
          "default": "NULL",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value",
          "type": "null"
        }
      },
      "title": "NullValue",
      "type": "object"
    },
    "NumberValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "NUMBER",
          "default": "NUMBER",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "NumberValue",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "node_type": {
          "const": "PREDICATE",
          "default": "PREDICATE",
          "title": "Node Type",
          "type": "string"
        },
        "field_ref": {
          "$ref": "#/$defs/BoundSemanticRef"
        },
        "operator": {
          "$ref": "#/$defs/FilterOperator"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "BOOLEAN": "#/$defs/BooleanValue",
              "DATE": "#/$defs/DateValue",
              "DATETIME": "#/$defs/DateTimeValue",
              "ENTITY_REF": "#/$defs/EntityValueRef",
              "ENUM": "#/$defs/EnumValue",
              "LIST": "#/$defs/ListValue",
              "NULL": "#/$defs/NullValue",
              "NUMBER": "#/$defs/NumberValue",
              "RANGE": "#/$defs/RangeValue",
              "STRING": "#/$defs/StringValue"
            },
            "propertyName": "value_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StringValue"
            },
            {
              "$ref": "#/$defs/NumberValue"
            },
            {
              "$ref": "#/$defs/BooleanValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/DateTimeValue"
            },
            {
              "$ref": "#/$defs/EnumValue"
            },
            {
              "$ref": "#/$defs/EntityValueRef"
            },
            {
              "$ref": "#/$defs/ListValue"
            },
            {
              "$ref": "#/$defs/RangeValue"
            },
            {
              "$ref": "#/$defs/NullValue"
            }
          ],
          "title": "Value"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "mention_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Mention Ids",
          "type": "array"
        },
        "scope": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "validation_status": {
          "$ref": "#/$defs/ProofStatus",
          "default": "UNKNOWN"
        }
      },
      "required": [
        "field_ref",
        "operator",
        "value",
        "source",
        "scope"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "ProjectionItem": {
      "additionalProperties": false,
      "properties": {
        "output_field_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Output Field Id",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundSemanticRef"
            },
            {
              "$ref": "#/$defs/ComputedMeasureRef"
            }
          ],
          "title": "Ref"
        },
        "role": {
          "$ref": "#/$defs/SemanticRole"
        },
        "display_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Label"
        },
        "alias_policy": {
          "default": "STABLE_ID",
          "enum": [
            "STABLE_ID",
            "GOVERNED_ALIAS"
          ],
          "title": "Alias Policy",
          "type": "string"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        }
      },
      "required": [
        "output_field_id",
        "ref",
        "role",
        "position"
      ],
      "title": "ProjectionItem",
      "type": "object"
    },
    "ProjectionSpec": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "EXPLICIT",
          "enum": [
            "EXPLICIT",
            "SEMANTIC_DEFAULT"
          ],
          "title": "Mode",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ProjectionItem"
          },
          "maxItems": 100,
          "title": "Items",
          "type": "array"
        },
        "default_display_policy_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Display Policy Id"
        }
      },
      "title": "ProjectionSpec",
      "type": "object"
    },
    "ProofStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "ProofStatus",
      "type": "string"
    },
    "RangeValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "RANGE",
          "default": "RANGE",
          "title": "Value Type",
          "type": "string"
        },
        "start": {
          "discriminator": {
            "mapping": {
              "BOOLEAN": "#/$defs/BooleanValue",
              "DATE": "#/$defs/DateValue",
              "DATETIME": "#/$defs/DateTimeValue",
              "ENTITY_REF": "#/$defs/EntityValueRef",
              "ENUM": "#/$defs/EnumValue",
              "NULL": "#/$defs/NullValue",
              "NUMBER": "#/$defs/NumberValue",
              "STRING": "#/$defs/StringValue"
            },
            "propertyName": "value_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StringValue"
            },
            {
              "$ref": "#/$defs/NumberValue"
            },
            {
              "$ref": "#/$defs/BooleanValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/DateTimeValue"
            },
            {
              "$ref": "#/$defs/EnumValue"
            },
            {
              "$ref": "#/$defs/EntityValueRef"
            },
            {
              "$ref": "#/$defs/NullValue"
            }
          ],
          "title": "Start"
        },
        "end": {
          "discriminator": {
            "mapping": {
              "BOOLEAN": "#/$defs/BooleanValue",
              "DATE": "#/$defs/DateValue",
              "DATETIME": "#/$defs/DateTimeValue",
              "ENTITY_REF": "#/$defs/EntityValueRef",
              "ENUM": "#/$defs/EnumValue",
              "NULL": "#/$defs/NullValue",
              "NUMBER": "#/$defs/NumberValue",
              "STRING": "#/$defs/StringValue"
            },
            "propertyName": "value_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StringValue"
            },
            {
              "$ref": "#/$defs/NumberValue"
            },
            {
              "$ref": "#/$defs/BooleanValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/DateTimeValue"
            },
            {
              "$ref": "#/$defs/EnumValue"
            },
            {
              "$ref": "#/$defs/EntityValueRef"
            },
            {
              "$ref": "#/$defs/NullValue"
            }
          ],
          "title": "End"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "RangeValue",
      "type": "object"
    },
    "RankingSpec": {
      "additionalProperties": false,
      "properties": {
        "rank_by": {
          "$ref": "#/$defs/BoundSemanticRef"
        },
        "direction": {
          "enum": [
            "ASC",
            "DESC"
          ],
          "title": "Direction",
          "type": "string"
        },
        "limit": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "ties_policy": {
          "default": "EXCLUDE_TIES",
          "enum": [
            "EXCLUDE_TIES",
            "INCLUDE_TIES"
          ],
          "title": "Ties Policy",
          "type": "string"
        },
        "nulls_policy": {
          "default": "EXCLUDE",
          "enum": [
            "FIRST",
            "LAST",
            "EXCLUDE"
          ],
          "title": "Nulls Policy",
          "type": "string"
        },
