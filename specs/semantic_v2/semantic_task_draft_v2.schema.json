{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AmbiguityDraft": {
      "additionalProperties": false,
      "properties": {
        "mention_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Mention Id",
          "type": "string"
        },
        "slot_path": {
          "enum": [
            "metrics",
            "dimensions",
            "subject"
          ],
          "title": "Slot Path",
          "type": "string"
        },
        "operation": {
          "enum": [
            "SET",
            "ADD",
            "REPLACE"
          ],
          "title": "Operation",
          "type": "string"
        },
        "candidate_handles": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 2,
          "title": "Candidate Handles",
          "type": "array"
        }
      },
      "required": [
        "mention_id",
        "slot_path",
        "operation",
        "candidate_handles"
      ],
      "title": "AmbiguityDraft",
      "type": "object"
    },
    "JsonValue": {},
    "SlotEditDraft": {
      "additionalProperties": false,
      "properties": {
        "slot_path": {
          "enum": [
            "subject",
            "metrics",
            "dimensions",
            "projection_spec",
            "filter_expression",
            "time_spec",
            "ranking_spec",
            "comparison_spec",
            "delivery_spec"
          ],
          "title": "Slot Path",
          "type": "string"
        },
        "operation": {
          "enum": [
            "SET",
            "ADD",
            "REPLACE",
            "REMOVE",
            "CLEAR"
          ],
          "title": "Operation",
          "type": "string"
        },
        "evidence_mention_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Evidence Mention Ids",
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "slot_path",
        "operation",
        "evidence_mention_ids"
      ],
      "title": "SlotEditDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "edits": {
      "items": {
        "$ref": "#/$defs/SlotEditDraft"
      },
      "maxItems": 50,
      "title": "Edits",
      "type": "array"
    },
    "payload_type": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Payload Type",
      "type": "string"
    },
    "historical_task_handle": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Historical Task Handle"
    },
    "dataset_handle": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Handle"
    },
    "dataset_operation": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "unresolved_mention_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Unresolved Mention Ids",
      "type": "array"
    },
    "ambiguities": {
      "items": {
        "$ref": "#/$defs/AmbiguityDraft"
      },
      "maxItems": 10,
      "title": "Ambiguities",
      "type": "array"
    }
  },
  "required": [
    "payload_type"
  ],
  "title": "SemanticTaskDraft",
  "type": "object"
}
