{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "BOOLEAN",
          "default": "BOOLEAN",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "BoundSemanticRef": {
      "additionalProperties": false,
      "description": "Accepted catalog identity. Scope is proved again at the plan boundary.",
      "properties": {
        "catalog_type": {
          "$ref": "#/$defs/CatalogType"
        },
        "semantic_role": {
          "$ref": "#/$defs/SemanticRole"
        },
        "canonical_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Canonical Id",
          "type": "string"
        },
        "canonical_code": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Canonical Code",
          "type": "string"
        },
        "display_name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "catalog_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Catalog Version",
          "type": "string"
        },
        "semantic_model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Semantic Model Id",
          "type": "string"
        },
        "business_domain_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Business Domain Ids",
          "type": "array"
        },
        "source_mention_ids": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Mention Ids",
          "type": "array"
        },
        "resolution_source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Resolution Source",
          "type": "string"
        }
      },
      "required": [
        "catalog_type",
        "semantic_role",
        "canonical_id",
        "canonical_code",
        "display_name",
        "catalog_version",
        "semantic_model_id",
        "business_domain_ids",
        "resolution_source"
      ],
      "title": "BoundSemanticRef",
      "type": "object"
    },
    "CandidateRejectionReason": {
      "enum": [
        "SCOPE_MISMATCH",
        "ROLE_MISMATCH",
        "FIELD_OWNERSHIP_MISMATCH",
        "RELATION_UNREACHABLE",
        "METRIC_DIMENSION_INCOMPATIBLE",
        "PERMISSION_DENIED",
        "CATALOG_VERSION_MISMATCH",
        "DUPLICATE_RELATION",
        "LOW_SCORE",
        "AMBIGUOUS_SCORE",
        "INVALID_GRAIN",
        "JOIN_CARDINALITY_UNSAFE",
        "UNKNOWN_BUSINESS_RULE"
      ],
      "title": "CandidateRejectionReason",
      "type": "string"
    },
    "CatalogType": {
      "enum": [
        "ENTITY",
        "METRIC",
        "DIMENSION",
        "ATTRIBUTE",
        "ENTITY_VALUE",
        "RELATION",
        "DATASET",
        "REPORT",
        "PHYSICAL_TABLE",
        "PHYSICAL_COLUMN"
      ],
      "title": "CatalogType",
      "type": "string"
    },
    "ClarificationDecision": {
      "additionalProperties": false,
      "properties": {
        "decision_type": {
          "const": "CLARIFICATION",
          "default": "CLARIFICATION",
          "title": "Decision Type",
          "type": "string"
        },
        "reason_type": {
          "const": "USER_AMBIGUITY",
          "default": "USER_AMBIGUITY",
          "title": "Reason Type",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ClarificationOption"
          },
          "title": "Options",
          "type": "array"
        },
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadinessBlocker"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "selected_option_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Option Id"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "affected_plan_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Affected Plan Paths",
          "type": "array"
        },
        "candidate_answers": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Candidate Answers",
          "type": "array"
        },
        "information_gain": {
          "default": 0,
          "minimum": 0,
          "title": "Information Gain",
          "type": "number"
        },
        "already_asked": {
          "default": false,
          "title": "Already Asked",
          "type": "boolean"
        },
        "asked_slots": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Asked Slots",
          "type": "array"
        },
        "fallback_available": {
          "default": false,
          "title": "Fallback Available",
          "type": "boolean"
        },
        "assumption_available": {
          "default": false,
          "title": "Assumption Available",
          "type": "boolean"
        },
        "base_task_version": {
          "minimum": 0,
          "title": "Base Task Version",
          "type": "integer"
        },
        "state_version": {
          "minimum": 0,
          "title": "State Version",
          "type": "integer"
        },
        "create_pending": {
          "default": false,
          "title": "Create Pending",
          "type": "boolean"
        }
      },
      "required": [
        "blocking",
        "base_task_version",
        "state_version"
      ],
      "title": "ClarificationDecision",
      "type": "object"
    },
    "ClarificationOption": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "display_label": {
          "minLength": 1,
          "title": "Display Label",
          "type": "string"
        },
        "canonical_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundSemanticRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "typed_value": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "BOOLEAN": "#/$defs/BooleanValue",
                  "DATE": "#/$defs/DateValue",
                  "DATETIME": "#/$defs/DateTimeValue",
                  "ENTITY_REF": "#/$defs/EntityValueRef",
                  "ENUM": "#/$defs/EnumValue",
                  "LIST": "#/$defs/ListValue",
                  "NULL": "#/$defs/NullValue",
                  "NUMBER": "#/$defs/NumberValue",
                  "RANGE": "#/$defs/RangeValue",
                  "STRING": "#/$defs/StringValue"
                },
                "propertyName": "value_type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/StringValue"
                },
                {
                  "$ref": "#/$defs/NumberValue"
                },
                {
                  "$ref": "#/$defs/BooleanValue"
                },
                {
                  "$ref": "#/$defs/DateValue"
                },
                {
                  "$ref": "#/$defs/DateTimeValue"
                },
                {
                  "$ref": "#/$defs/EnumValue"
                },
                {
                  "$ref": "#/$defs/EntityValueRef"
                },
                {
                  "$ref": "#/$defs/ListValue"
                },
                {
                  "$ref": "#/$defs/RangeValue"
                },
                {
                  "$ref": "#/$defs/NullValue"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typed Value"
        },
        "evidence": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "option_id",
        "display_label",
        "evidence"
      ],
      "title": "ClarificationOption",
      "type": "object"
    },
    "DateTimeValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "DATETIME",
          "default": "DATETIME",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "format": "date-time",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "DateTimeValue",
      "type": "object"
    },
    "DateValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "DATE",
          "default": "DATE",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "format": "date",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "DateValue",
      "type": "object"
    },
    "DialogueAct": {
      "enum": [
        "NEW_TASK",
        "CONTINUE",
        "MODIFY",
        "ADD",
        "REPLACE",
        "REMOVE",
        "CLEAR",
        "CORRECT",
        "DRILL_DOWN",
        "SWITCH_TOPIC",
        "RETURN_TO_TOPIC",
        "ANSWER_CLARIFICATION",
        "CANCEL",
        "CONFIRM",
        "FEEDBACK",
        "REFRESH",
        "REVISE",
        "CHAT"
      ],
      "title": "DialogueAct",
      "type": "string"
    },
    "EntityValueRef": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "ENTITY_REF",
          "default": "ENTITY_REF",
          "title": "Value Type",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/BoundSemanticRef"
        }
      },
      "required": [
        "ref"
      ],
      "title": "EntityValueRef",
      "type": "object"
    },
    "EnumValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "ENUM",
          "default": "ENUM",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "enum_code": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Enum Code",
          "type": "string"
        }
      },
      "required": [
        "value",
        "enum_code"
      ],
      "title": "EnumValue",
      "type": "object"
    },
    "ErrorType": {
      "enum": [
        "USER_AMBIGUITY",
        "SURFACE_PARSE_FAILURE",
        "SEMANTIC_RESOLUTION_FAILURE",
        "PLAN_VALIDATION_FAILURE",
        "ASL_CONTRACT_FAILURE",
        "SQL_PLAN_FAILURE",
        "EXECUTION_FAILURE",
        "RESULT_CONTRACT_FAILURE",
        "NO_DATA",
        "PERMISSION_DENIED",
        "DATA_NOT_READY"
      ],
      "title": "ErrorType",
      "type": "string"
    },
    "JsonValue": {},
    "ListValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "LIST",
          "default": "LIST",
          "title": "Value Type",
          "type": "string"
        },
        "values": {
          "items": {
            "discriminator": {
              "mapping": {
                "BOOLEAN": "#/$defs/BooleanValue",
                "DATE": "#/$defs/DateValue",
                "DATETIME": "#/$defs/DateTimeValue",
                "ENTITY_REF": "#/$defs/EntityValueRef",
                "ENUM": "#/$defs/EnumValue",
                "NULL": "#/$defs/NullValue",
                "NUMBER": "#/$defs/NumberValue",
                "STRING": "#/$defs/StringValue"
              },
              "propertyName": "value_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/StringValue"
              },
              {
                "$ref": "#/$defs/NumberValue"
              },
              {
                "$ref": "#/$defs/BooleanValue"
              },
              {
                "$ref": "#/$defs/DateValue"
              },
              {
                "$ref": "#/$defs/DateTimeValue"
              },
              {
                "$ref": "#/$defs/EnumValue"
              },
              {
                "$ref": "#/$defs/EntityValueRef"
              },
              {
                "$ref": "#/$defs/NullValue"
              }
            ]
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "title": "ListValue",
      "type": "object"
    },
    "NullValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "NULL",
          "default": "NULL",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value",
          "type": "null"
        }
      },
      "title": "NullValue",
      "type": "object"
    },
    "NumberValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "NUMBER",
          "default": "NUMBER",
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "NumberValue",
      "type": "object"
    },
    "PlanCandidate": {
      "additionalProperties": false,
      "description": "One globally constrained plan candidate built only from catalog IDs.",
      "properties": {
        "plan_candidate_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Plan Candidate Id",
          "type": "string"
        },
        "semantic_candidate_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Semantic Candidate Ids",
          "type": "array"
        },
        "score": {
          "$ref": "#/$defs/PlanCandidateScore"
        },
        "executable": {
          "title": "Executable",
          "type": "boolean"
        },
        "rejection_reasons": {
          "items": {
            "$ref": "#/$defs/CandidateRejectionReason"
          },
          "title": "Rejection Reasons",
          "type": "array"
        },
        "validation_errors": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Validation Errors",
          "type": "array"
        }
      },
      "required": [
        "plan_candidate_id",
        "semantic_candidate_ids",
        "score",
        "executable"
      ],
      "title": "PlanCandidate",
      "type": "object"
    },
    "PlanCandidateScore": {
      "additionalProperties": false,
      "description": "Deterministic and retrieval components of a complete plan score.",
      "properties": {
        "retrieval_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Retrieval Score",
          "type": "number"
        },
        "constraint_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Constraint Score",
          "type": "number"
        },
        "permission_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Permission Score",
          "type": "number"
        },
        "executability_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Executability Score",
          "type": "number"
        },
        "scoring_version": {
          "const": "weighted-v1",
          "default": "weighted-v1",
          "title": "Scoring Version",
          "type": "string"
        },
        "weights_version": {
          "const": "equal-v1",
          "default": "equal-v1",
          "title": "Weights Version",
          "type": "string"
        },
        "model_self_reported_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Self Reported Confidence"
        },
        "calibrated_probability": {
          "default": null,
          "title": "Calibrated Probability",
          "type": "null"
        }
      },
      "required": [
        "retrieval_score",
        "constraint_score",
        "permission_score",
        "executability_score"
      ],
      "title": "PlanCandidateScore",
      "type": "object"
    },
    "Presence": {
      "enum": [
        "UNSPECIFIED",
        "PRESENT",
        "EXPLICITLY_CLEARED",
        "AMBIGUOUS",
        "NOT_APPLICABLE",
        "INVALID"
      ],
      "title": "Presence",
      "type": "string"
    },
    "ProceedDecision": {
      "additionalProperties": false,
      "properties": {
        "decision_type": {
          "const": "PROCEED",
          "default": "PROCEED",
          "title": "Decision Type",
          "type": "string"
        },
        "create_pending": {
          "const": false,
          "default": false,
          "title": "Create Pending",
          "type": "boolean"
        }
      },
      "title": "ProceedDecision",
      "type": "object"
    },
    "RangeValue": {
      "additionalProperties": false,
      "properties": {
        "value_type": {
          "const": "RANGE",
          "default": "RANGE",
          "title": "Value Type",
          "type": "string"
        },
        "start": {
          "discriminator": {
            "mapping": {
              "BOOLEAN": "#/$defs/BooleanValue",
              "DATE": "#/$defs/DateValue",
              "DATETIME": "#/$defs/DateTimeValue",
              "ENTITY_REF": "#/$defs/EntityValueRef",
              "ENUM": "#/$defs/EnumValue",
              "NULL": "#/$defs/NullValue",
              "NUMBER": "#/$defs/NumberValue",
              "STRING": "#/$defs/StringValue"
            },
            "propertyName": "value_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StringValue"
            },
            {
              "$ref": "#/$defs/NumberValue"
            },
            {
              "$ref": "#/$defs/BooleanValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/DateTimeValue"
            },
            {
              "$ref": "#/$defs/EnumValue"
            },
            {
              "$ref": "#/$defs/EntityValueRef"
            },
            {
              "$ref": "#/$defs/NullValue"
            }
          ],
          "title": "Start"
        },
        "end": {
          "discriminator": {
            "mapping": {
              "BOOLEAN": "#/$defs/BooleanValue",
              "DATE": "#/$defs/DateValue",
              "DATETIME": "#/$defs/DateTimeValue",
              "ENTITY_REF": "#/$defs/EntityValueRef",
              "ENUM": "#/$defs/EnumValue",
              "NULL": "#/$defs/NullValue",
              "NUMBER": "#/$defs/NumberValue",
              "STRING": "#/$defs/StringValue"
            },
            "propertyName": "value_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StringValue"
            },
            {
              "$ref": "#/$defs/NumberValue"
            },
            {
              "$ref": "#/$defs/BooleanValue"
            },
            {
              "$ref": "#/$defs/DateValue"
            },
            {
              "$ref": "#/$defs/DateTimeValue"
            },
            {
              "$ref": "#/$defs/EnumValue"
            },
            {
              "$ref": "#/$defs/EntityValueRef"
            },
            {
              "$ref": "#/$defs/NullValue"
            }
          ],
          "title": "End"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "RangeValue",
      "type": "object"
    },
    "ReadinessBlocker": {
      "additionalProperties": false,
      "properties": {
        "blocker_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Blocker Id",
          "type": "string"
        },
        "plan_path": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Plan Path",
          "type": "string"
        },
        "blocker_type": {
          "$ref": "#/$defs/ErrorType"
        },
        "source_stage": {
          "enum": [
            "PARSE",
            "RESOLUTION",
            "PLAN",
            "PERMISSION",
            "DATA",
            "ASL",
            "SQL",
            "RESULT"
          ],
          "title": "Source Stage",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "BLOCKING"
        },
        "user_action_required": {
          "default": false,
          "title": "User Action Required",
          "type": "boolean"
        },
        "expected_answer_type": {
          "default": "NONE",
          "enum": [
            "OPTION_ID",
            "SEMANTIC_REF",
            "TYPED_VALUE",
            "NONE"
          ],
          "title": "Expected Answer Type",
          "type": "string"
        },
        "candidate_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "system_repairable": {
          "default": false,
          "title": "System Repairable",
          "type": "boolean"
        },
        "message_code": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Message Code",
          "type": "string"
        }
      },
      "required": [
        "blocker_id",
        "plan_path",
        "blocker_type",
        "source_stage",
        "message_code"
      ],
      "title": "ReadinessBlocker",
      "type": "object"
    },
    "ResolutionStatus": {
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "AMBIGUOUS",
        "UNRESOLVED"
      ],
      "title": "ResolutionStatus",
      "type": "string"
    },
    "SemanticCandidate": {
      "additionalProperties": false,
      "description": "Auditable candidate retained before global plan selection.",
      "properties": {
        "candidate_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "mention_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Mention Id",
          "type": "string"
        },
        "candidate_role": {
          "$ref": "#/$defs/SemanticRole"
        },
        "catalog_type": {
          "$ref": "#/$defs/CatalogType"
        },
        "canonical_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Canonical Id",
          "type": "string"
        },
        "canonical_code": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Canonical Code",
