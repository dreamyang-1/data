DATA_AGENT_ENV=development
# Required: use the business backend's existing service Bearer authKey.
# Keep the real token in deployment secrets. Blank rejects service requests.
DATA_AGENT_TRUSTED_BACKEND_TOKEN=
# Backend must forward X-Tenant-Id and X-User-Id on every request.
# X-Application-Id is required in production and must match application_id.
DATA_AGENT_ADAPTER_MODE=mock
# Optional full URL. When empty, REDIS_HOST/PORT/DB/PASSWORD are inherited
# from E:\YouoAgent\.env without copying the password into this project.
DATA_AGENT_REDIS_URL=
DATA_AGENT_SESSION_STORE_MODE=redis
DATA_AGENT_SESSION_KEY_PREFIX=youo:data-analysis:v2
DATA_AGENT_SESSION_TTL_SECONDS=7200
# Must cover the pending-conversation TTL so an old message cannot later be
# mistaken for a new clarification.
DATA_AGENT_RESPONSE_CACHE_TTL_SECONDS=7200
# Startup-fixed engine. V1 remains the default until a reviewed deployment
# explicitly selects the limited candidate.
DATA_AGENT_RUNTIME_MODE=V1
# Required only for V2_LIMITED_SCALAR. Values below are non-secret pins; keep
# Redis/model/database credentials in the existing deployment secret source.
DATA_AGENT_LIMITED_SCALAR_STORE_NAMESPACE=youo:data-analysis:v2-limited-scalar:internal-canary
DATA_AGENT_LIMITED_SCALAR_DEPLOYMENT_ID=internal-canary
DATA_AGENT_LIMITED_SCALAR_SESSION_TTL_SECONDS=86400
DATA_AGENT_LIMITED_SCALAR_IDEMPOTENCY_TTL_SECONDS=604800
DATA_AGENT_LIMITED_SCALAR_RUNNING_REVIEW_SECONDS=300
DATA_AGENT_LIMITED_SCALAR_MAX_MESSAGES_PER_SESSION=100
DATA_AGENT_LIMITED_SCALAR_MAX_ENVELOPE_BYTES=4194304
DATA_AGENT_LIMITED_SCALAR_SEMANTIC_MODEL_ID=81
DATA_AGENT_LIMITED_SCALAR_BUSINESS_DOMAIN_IDS=[205]
DATA_AGENT_LIMITED_SCALAR_DATA_SOURCE_ID=58
DATA_AGENT_LIMITED_SCALAR_CATALOG_VERSION=
DATA_AGENT_LIMITED_SCALAR_VECTOR_INDEX_VERSION=
DATA_AGENT_LIMITED_SCALAR_CATALOG_TARGET_IDENTITY_HASH=
# Internal 8088 trial only: reads and pins the current authoritative catalog in
# process memory without creating/changing a vector collection. Default remains
# the governed PUBLISHED catalog path.
DATA_AGENT_LIMITED_SCALAR_CATALOG_ACCESS=PUBLISHED
DATA_AGENT_LIMITED_SCALAR_OAGNET_SOURCE_DIGEST=
DATA_AGENT_LIMITED_SCALAR_SQL_SOURCE_DIGEST=
# SHA-256-style contract digest over the approved non-secret source target:
# driver, host, port, database, schema and account identity.
DATA_AGENT_LIMITED_SCALAR_DATA_SOURCE_TARGET_DIGEST=
DATA_AGENT_LIMITED_SCALAR_READINESS_CACHE_SECONDS=5
DATA_AGENT_LIMITED_SCALAR_READINESS_TIMEOUT_SECONDS=5
DATA_AGENT_LIMITED_SCALAR_CANCELLATION_CLEANUP_SECONDS=2
DATA_AGENT_LIMITED_SCALAR_TIME_FIELD_CANONICAL_ID=
DATA_AGENT_LIMITED_SCALAR_TIME_FIELD_MAPPING=sales_order.created_date
DATA_AGENT_LIMITED_SCALAR_TIME_FIELD_ID=24400
DATA_AGENT_LIMITED_SCALAR_TIME_TABLE_ID=1880
DATA_AGENT_LIMITED_SCALAR_TIME_STORAGE_TIMEZONE=Asia/Shanghai
DATA_AGENT_LIMITED_SCALAR_TIME_EVIDENCE_VERSION=round59-user-declaration-beijing-v1
# Production should require and verify X-Application-Id from the Java gateway.
DATA_AGENT_REQUIRE_TRUSTED_APPLICATION_HEADER=false

# Confirmed long-term preferences use MySQL as the source of truth. The service
# also accepts the platform's MYSQL_* names; DATA_AGENT_* values take precedence.
DATA_AGENT_LONG_TERM_MEMORY_MODE=mysql
DATA_AGENT_LONG_TERM_MEMORY_MAX_ITEMS=20
DATA_AGENT_MYSQL_HOST=127.0.0.1
DATA_AGENT_MYSQL_PORT=3306
DATA_AGENT_MYSQL_USER=
DATA_AGENT_MYSQL_PASSWORD=
DATA_AGENT_MYSQL_DATABASE=
DATA_AGENT_MYSQL_CONNECT_TIMEOUT_SECONDS=5
DATA_AGENT_MYSQL_READ_TIMEOUT_SECONDS=10
DATA_AGENT_MYSQL_WRITE_TIMEOUT_SECONDS=10
DATA_AGENT_MAX_CLARIFICATION_ROUNDS=3
DATA_AGENT_REQUEST_TIMEOUT_SECONDS=120
DATA_AGENT_SEMANTIC_BASE_URL=http://localhost:8101
# Natural language -> ASL (Oagnet)
DATA_AGENT_ASL_GENERATOR_BASE_URL=http://192.168.1.49:8021
DATA_AGENT_ASL_GENERATOR_PATH=/agent/query
DATA_AGENT_ASL_GENERATION_TIMEOUT_SECONDS=90
DATA_AGENT_ASL_PLAN_CACHE_TTL_SECONDS=300
DATA_AGENT_ASL_PLAN_CACHE_MAX_ITEMS=256
# ASL -> SQL -> database result (semantic-layer service)
DATA_AGENT_SQL_TRANSLATOR_BASE_URL=http://192.168.1.49:48000
DATA_AGENT_SQL_TRANSLATOR_PATH=/api/ast-to-sql
# information_safety_test defaults to 127.0.0.1:7873; replace host after deployment.
DATA_AGENT_KNOWLEDGE_BASE_URL=http://127.0.0.1:7873
# Prefer the shared platform KB_API_KEY. This service-specific name can be
# used as an override when the agent and KB service use separate credentials.
DATA_AGENT_KNOWLEDGE_BASE_API_KEY=
DATA_AGENT_KNOWLEDGE_BASE_SEARCH_PATH=/knowledge_base/search_docs
DATA_AGENT_KNOWLEDGE_BASE_TIMEOUT_SECONDS=30
DATA_AGENT_PLATFORM_API_KEY=
DATA_AGENT_HTTP_MAX_RETRIES=2
DATA_AGENT_HTTP_RETRY_BACKOFF_SECONDS=0.2
# Optional emergency fallback only. Normally Java passes knowledge_base_names per request.
DATA_AGENT_KNOWLEDGE_BASE_NAMES=[]
DATA_AGENT_KNOWLEDGE_RETRIEVAL_METHOD=hybrid
DATA_AGENT_KNOWLEDGE_TOP_K=5
DATA_AGENT_ANALYSIS_KNOWLEDGE_TOP_K=5
DATA_AGENT_ANALYSIS_KNOWLEDGE_EXCERPT_CHARS=500
DATA_AGENT_KNOWLEDGE_SCORE_THRESHOLD=1.0
DATA_AGENT_KNOWLEDGE_SCORE_TYPE=distance
DATA_AGENT_KNOWLEDGE_MIN_NORMALIZED_RELEVANCE=0.50
DATA_AGENT_KNOWLEDGE_MAX_PER_SOURCE=2
DATA_AGENT_KNOWLEDGE_CACHE_ENABLED=true
DATA_AGENT_KNOWLEDGE_CACHE_TTL_SECONDS=300
DATA_AGENT_KNOWLEDGE_CACHE_LOCK_SECONDS=10
DATA_AGENT_KNOWLEDGE_CACHE_WAIT_SECONDS=3
DATA_AGENT_KNOWLEDGE_INDEX_VERSION=unversioned
DATA_AGENT_DATA_QUERY_MAX_ROWS=1000
DATA_AGENT_MINIO_DATASET_ENABLED=false
DATA_AGENT_MINIO_ENDPOINT=127.0.0.1:9000
DATA_AGENT_MINIO_ACCESS_KEY=
DATA_AGENT_MINIO_SECRET_KEY=
DATA_AGENT_MINIO_BUCKET=
DATA_AGENT_MINIO_SECURE=false
# 未设置 DATA_AGENT_MINIO_* 时，也兼容平台根 .env 中的
# MINIO_ENDPOINT/MINIO_HOST、MINIO_ACCESS_KEY、MINIO_SECRET_KEY，
# Bucket 优先使用 AGENT_MINIO_BUCKET，其次 MINIO_BUCKET。
DATA_AGENT_DATASET_SMALL_MAX_ROWS=10000
DATA_AGENT_DATASET_SMALL_MAX_BYTES=5242880
DATA_AGENT_DATASET_MEDIUM_MAX_ROWS=1000000
DATA_AGENT_DATASET_MEDIUM_MAX_BYTES=268435456
DATA_AGENT_DATASET_PARQUET_PART_ROWS=50000
DATA_AGENT_INTENT_MODEL_ENABLED=true
DATA_AGENT_INTENT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DATA_AGENT_INTENT_MODEL_API_KEY=
DATA_AGENT_INTENT_MODEL_NAME=qwen3.7-max
DATA_AGENT_INTENT_MODEL_RESPONSE_FORMAT=json_object
DATA_AGENT_INTENT_MODEL_TIMEOUT_SECONDS=30
DATA_AGENT_INTENT_MODEL_ENABLE_THINKING=false
DATA_AGENT_INTENT_MODEL_MIN_CONFIDENCE=0.80
DATA_AGENT_MULTI_QUESTION_ENABLED=true
DATA_AGENT_MULTI_QUESTION_MODEL_ENABLED=true
DATA_AGENT_MULTI_QUESTION_MAX_TASKS=5
DATA_AGENT_MULTI_QUESTION_MODEL_TIMEOUT_SECONDS=15
DATA_AGENT_ANALYSIS_SYNTHESIS_ENABLED=true
DATA_AGENT_ANALYSIS_SYNTHESIS_MODEL_NAME=qwen3.7-max
DATA_AGENT_ANALYSIS_SYNTHESIS_TIMEOUT_SECONDS=8
DATA_AGENT_ANALYSIS_SYNTHESIS_MAX_RETRIES=0
DATA_AGENT_CHAT_MODEL_ENABLED=true
DATA_AGENT_CHAT_MODEL_NAME=qwen3.7-max
DATA_AGENT_CHAT_MODEL_TIMEOUT_SECONDS=8
DATA_AGENT_CHAT_MODEL_MAX_RETRIES=0

# ---------- Langfuse 可观测性（有完整连接配置时启用，默认不上传正文） ----------
# 启用必须同时提供 enabled/public/secret/base URL。标准 LANGFUSE_* 和
# DATA_AGENT_LANGFUSE_* 前缀均兼容。生产环境建议设置独立 HASH_SALT。
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_CAPTURE_CONTENT=false
DATA_AGENT_LANGFUSE_SAMPLE_RATE=1.0
DATA_AGENT_LANGFUSE_ENVIRONMENT=development
DATA_AGENT_LANGFUSE_RELEASE=
LANGFUSE_HASH_SALT=
